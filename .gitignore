__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
build/
dist/
.coverage
htmlcov/

# raw datasets are downloaded manually, not committed
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/synthetic/generated/*
!data/synthetic/generated/.gitkeep
# human-reviewed messages can contain real (possibly personal) message
# text - never commit, see docs/production_readiness.md
data/review/*
!data/review/.gitkeep

# manually-relabeled public-dataset rows (scripts/label_tool.py) - same
# rationale as data/review/: real message text, not ours to redistribute
# even though the source dataset is public (see manual_labels.py)
data/manual_labels/*
!data/manual_labels/.gitkeep

.env

# trained model weights/checkpoints - too large for git, reproducible via
# scripts/train_model.py
models/

